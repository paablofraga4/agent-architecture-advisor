# ---- LLM ----
OPENAI_API_KEY=sk-...

# ---- Qdrant ----
# In production point at the Qdrant server (Railway/Fly service). Leave defaults
# for local embedded mode.
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---- Auth / quota (Supabase) ----
# Leave ALL three empty to run the API in OPEN mode (no auth) for local dev.
# Production MUST set them. Find them in Supabase > Project Settings > API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- CORS ----
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ---- Observability (optional) ----
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
HF_TOKEN=
